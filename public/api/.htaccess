# config*.php fayllarini birbaxa veb erisimden qoru
# PHP include()-lar hala isleyir, yalniz birbaxa HTTP sorgusu blok edilir

<Files "config*.php">
    Require all denied
</Files>

<Files "auth.php">
    Require all denied
</Files>

# Yalniz include edilen helper-ler (birbaxa cagirilmamalidir)
<Files "gallery_auth.php">
    Require all denied
</Files>

<Files "media_policy.php">
    Require all denied
</Files>

# Struktur media loglari — slug/olcu/xeta melumatlari sizmasin
RedirectMatch 404 ^/api/_logs/

# Phase 45.3 — sxem SQL fayllari (cedvel strukturu) HTTP ile acilmasin
RedirectMatch 404 ^/api/migrations/

<Files "slug_alloc.php">
    Require all denied
</Files>

<Files "media_store.php">
    Require all denied
</Files>

# Phase 43 — qalereya media qati yalniz include edilir (birbaxa cagirilmamalidir)
<Files "gallery_media.php">
    Require all denied
</Files>

# Phase 44 — hekaye sekillerinin saxlama komekcileri (yalniz include)
<Files "story_media.php">
    Require all denied
</Files>

# Phase 45 — acilis/hekaye override-larinin yoxlama qaydalari (yalniz include)
<Files "admin_content_rules.php">
    Require all denied
</Files>

# Phase 45 — admin sekillerinin saxlama komekcileri (yalniz include)
<Files "admin_media.php">
    Require all denied
</Files>
