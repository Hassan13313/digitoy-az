# config*.php fayllarini birbaxa veb erisimden qoru
# PHP include()-lar hala isleyir, yalniz birbaxa HTTP sorgusu blok edilir

<Files "config*.php">
    Require all denied
</Files>

<Files "auth.php">
    Require all denied
</Files>

# Yalniz include edilen helper-ler (birbaxa cagirilmamalidir)
<Files "gallery_auth.php">
    Require all denied
</Files>

<Files "media_policy.php">
    Require all denied
</Files>

# Struktur media loglari — slug/olcu/xeta melumatlari sizmasin
RedirectMatch 404 ^/api/_logs/
